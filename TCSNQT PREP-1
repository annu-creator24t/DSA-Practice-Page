1-Sum of Array

class Solution {
    public int arraySum(int arr[]) {
        int sum=0;
        for(int i=0;i<=arr.length-1;i++){
            sum += arr[i];
        }
        return sum;
    }
}


2-Largest Element in Array

class Solution {
    public static int largest(int[] arr) {
        int largest = arr[0];
        for(int i=0;i<arr.length;i++){
            if (arr[i]>largest){
                largest=arr[i];
            }
        }
        return largest;
    }
}
