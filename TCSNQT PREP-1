1-Sum of Array

class Solution {
    public int arraySum(int arr[]) {
        int sum=0;
        for(int i=0;i<=arr.length-1;i++){
            sum += arr[i];
        }
        return sum;
    }
}


2-Largest Element in Array

class Solution {
    public static int largest(int[] arr) {
        int largest = arr[0];
        for(int i=0;i<arr.length;i++){
            if (arr[i]>largest){
                largest=arr[i];
            }
        }
        return largest;
    }
}

3-Mean or Average of an Array

class Solution {
    public static int findMean(int[] arr) {
       int sum=0;
        for(int i=0;i<arr.length;i++){
            sum+=arr[i];
        }
        return sum/arr.length;
        
    }
};

4-Reverse Array

class Solution {
    public void reverseArray(int arr[]) {
        int left = 0;
        int right = arr.length - 1;

        while (left < right) {
            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;

            left++;
            right--;
        }
    }
}
